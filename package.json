{
  "name": "mensajitos",
  "version": "1.0.0",
  "description": "Mensajes románticos en tiempo real",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "electron": "electron .",
    "build": "electron-builder"
  },
  "dependencies": {},
  "devDependencies": {
    "electron": "^30.5.1",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.mensajitos.app",
    "productName": "Mensajitos",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/main.cjs",
      "electron/preload.cjs",
      "src/overlay.html",
      "src/icon.png",
      "package.json"
    ],
    "mac": {
      "target": "dmg",
      "icon": "src/icon.png",
      "hardenedRuntime": false
    },
    "asar": true,
    "forceCodeSigning": false
  }
}