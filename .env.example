# Variables de entorno para Mensajitos
# Copiar a .env.local y completar (no commitear .env.local)

# Base URL pública para links absolutos de imágenes
# En Render: https://<servicio>.onrender.com
# En local: dejar vacío o http://localhost:3000
PUBLIC_URL=

# Entorno (production en Render)
NODE_ENV=development

# Host para bind (0.0.0.0 en producción, localhost en dev si se prefiere)
# Render inyecta PORT automáticamente; NO definir PORT a mano
HOST=0.0.0.0